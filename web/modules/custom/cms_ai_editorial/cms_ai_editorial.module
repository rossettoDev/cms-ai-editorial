<?php

/**
 * @file
 * Módulo principal do CMS AI Editorial.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_FORM_ID_alter() for node_editorial_article_form.
 */
function cms_ai_editorial_form_node_editorial_article_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Ocultar campo de justificativa por padrão
  // Será mostrado via JavaScript quando a transição "return_to_draft" for selecionada
  if (isset($form['field_return_justification'])) {
    $form['field_return_justification']['#states'] = [
      'visible' => [
        ':input[name="moderation_state[0][state]"]' => ['value' => 'draft'],
      ],
    ];
    
    // Adicionar descrição contextual
    $node = $form_state->getFormObject()->getEntity();
    if ($node->isNew() || $node->get('moderation_state')->value !== 'needs_review') {
      $form['field_return_justification']['#access'] = FALSE;
    }
  }

  // Adicionar validação customizada
  $form['#validate'][] = 'cms_ai_editorial_node_form_validate';
}

/**
 * Implements hook_form_FORM_ID_alter() for node_editorial_article_edit_form.
 */
function cms_ai_editorial_form_node_editorial_article_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  cms_ai_editorial_form_node_editorial_article_form_alter($form, $form_state, $form_id);
}

/**
 * Validação customizada para o formulário de artigo editorial.
 */
function cms_ai_editorial_node_form_validate(array &$form, FormStateInterface $form_state) {
  $node = $form_state->getFormObject()->getEntity();
  
  // Verificar se está mudando de needs_review para draft (devolução)
  if (!$node->isNew() && isset($node->moderation_state)) {
    $current_state = $node->get('moderation_state')->value;
    $new_state = $form_state->getValue(['moderation_state', 0, 'state']);
    
    // Se está devolvendo de needs_review para draft, exigir justificativa
    if ($current_state === 'needs_review' && $new_state === 'draft') {
      $justification = $form_state->getValue('field_return_justification');
      
      if (empty($justification[0]['value'])) {
        $form_state->setErrorByName('field_return_justification', 
          t('Justificativa é obrigatória ao devolver o artigo para edição.'));
      }
    }
  }
}

/**
 * Implements hook_node_access().
 */
function cms_ai_editorial_node_access(NodeInterface $node, $op, AccountInterface $account) {
  // Apenas aplicar para o tipo editorial_article
  if ($node->bundle() !== 'editorial_article') {
    return AccessResult::neutral();
  }

  // Administradores têm acesso total
  if ($account->hasPermission('administer nodes')) {
    return AccessResult::neutral();
  }

  // Controle de acesso para visualização
  if ($op === 'view') {
    // Conteúdo publicado é visível para todos
    if ($node->isPublished()) {
      return AccessResult::neutral();
    }

    // Verificar estado de moderação
    $moderation_state = $node->get('moderation_state')->value ?? 'draft';
    
    // Editorial reviewers podem ver qualquer conteúdo não publicado
    if ($account->hasPermission('view any unpublished editorial_article content')) {
      return AccessResult::allowed()->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
    }

    // AI Editors podem ver apenas seus próprios rascunhos
    if ($account->hasPermission('view own unpublished editorial_article content')) {
      if ($node->getOwnerId() === $account->id()) {
        return AccessResult::allowed()->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
      }
      return AccessResult::forbidden('Editor can only view own unpublished content')
        ->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
    }

    // Negar acesso a rascunhos para outros usuários
    return AccessResult::forbidden('No permission to view unpublished content')
      ->cachePerPermissions()->addCacheableDependency($node);
  }

  // Controle de acesso para edição
  if ($op === 'update') {
    // Editorial reviewers podem editar qualquer artigo
    if ($account->hasPermission('edit any editorial_article content')) {
      return AccessResult::neutral();
    }

    // AI Editors podem editar apenas seus próprios artigos
    if ($account->hasPermission('edit own editorial_article content')) {
      if ($node->getOwnerId() === $account->id()) {
        return AccessResult::allowed()->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
      }
      return AccessResult::forbidden('Editor can only edit own content')
        ->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
    }

    return AccessResult::forbidden('No permission to edit content')
      ->cachePerPermissions()->addCacheableDependency($node);
  }

  // Controle de acesso para deleção
  if ($op === 'delete') {
    // AI Editors podem deletar apenas seus próprios artigos
    if ($account->hasPermission('delete own editorial_article content')) {
      if ($node->getOwnerId() === $account->id()) {
        return AccessResult::allowed()->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
      }
      return AccessResult::forbidden('Editor can only delete own content')
        ->cachePerPermissions()->cachePerUser()->addCacheableDependency($node);
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_entity_access().
 */
function cms_ai_editorial_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  // Delegar para hook_node_access para nodes
  if ($entity->getEntityTypeId() === 'node') {
    return AccessResult::neutral();
  }
  
  return AccessResult::neutral();
}

/**
 * Implements hook_node_presave().
 */
function cms_ai_editorial_node_presave(NodeInterface $node) {
  // Apenas para artigos editoriais
  if ($node->bundle() !== 'editorial_article') {
    return;
  }

  // Limpar justificativa se não for uma devolução
  if (isset($node->original)) {
    $original_state = $node->original->get('moderation_state')->value ?? 'draft';
    $new_state = $node->get('moderation_state')->value ?? 'draft';

    // Se não é uma devolução, limpar a justificativa anterior
    if (!($original_state === 'needs_review' && $new_state === 'draft')) {
      // Manter o histórico, mas podemos adicionar lógica aqui se necessário
    }
  }
}
