# CMS AI Editorial - Environment Configuration
# 
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com credenciais reais!

# Configuração do banco de dados
# Para Lando, use: mysql://drupal:drupal@database/drupal
DB_HOST=localhost
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=
DB_DRIVER=mysql

# Configuração do site
SITE_NAME="CMS AI Editorial"
SITE_MAIL=admin@example.com
ACCOUNT_NAME=admin
ACCOUNT_MAIL=admin@example.com

# Hash salt do Drupal (gere com: drush php-eval 'echo \Drupal\Component\Utility\Crypt::randomBytesBase64(55);')
# IMPORTANTE: Gere um novo valor para produção!
DRUPAL_HASH_SALT=

# Ambiente
ENVIRONMENT=local
# Opções: local, development, staging, production

# Configuração de arquivos
# Caminho relativo ao webroot para arquivos privados
PRIVATE_FILES_PATH=../private

# Configuração de IA (a ser implementado em US futuras)
# Deixe vazio ou use 'mock' para modo de desenvolvimento sem chamadas reais
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Configuração de cache (opcional)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuração de email (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PROTOCOL=tls

# Trusted host patterns (separados por |)
# Exemplo: ^localhost$|^127\.0\.0\.1$|^.*\.lndo\.site$
TRUSTED_HOST_PATTERNS=

# Modo de desenvolvimento
# true = mostrar erros, desabilitar cache agregado, etc.
DEV_MODE=true

# Configuração de logging
SYSLOG_IDENTITY=cms_ai_editorial
SYSLOG_FACILITY=128
